# ─────────────────────────────────────────────
#  ReactCMS Backend — Environment Configuration
# ─────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Database
# Local PostgreSQL - Already configured
DATABASE_URL="postgresql://postgres:ali980@localhost:5432/CMS?schema=public"

# Redis (DISABLED - Not needed)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_ENABLED=false

# JWT
JWT_SECRET=reactcms-super-secret-jwt-key-change-in-production-min-32-chars-long
JWT_REFRESH_SECRET=reactcms-refresh-secret-key-change-in-production-min-32-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OpenAI (OPTIONAL - Only needed for AI features)
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL=gpt-4-turbo-preview
# OPENAI_MAX_TOKENS=4096

# Storage (local or s3)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads

# AWS S3 (if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=reactcms-uploads

# Crawler
CRAWLER_MAX_CONCURRENT=5
CRAWLER_PAGE_TIMEOUT=30000
CRAWLER_HEADLESS=true

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Encryption
ENCRYPTION_KEY=reactcms-32-char-encryption-key
