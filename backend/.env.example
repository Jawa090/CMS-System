# ─────────────────────────────────────────────
#  ReactCMS Backend — Environment Configuration
# ─────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://reactcms:password@localhost:5432/reactcms_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=4096

# Storage (local or s3)
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads

# AWS S3 (if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=reactcms-uploads

# Crawler
CRAWLER_MAX_CONCURRENT=5
CRAWLER_PAGE_TIMEOUT=30000
CRAWLER_HEADLESS=true

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Encryption
ENCRYPTION_KEY=your-32-char-encryption-key-here!!
